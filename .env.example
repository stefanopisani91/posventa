# Copy to .env for local development (never commit the real file).
# On Netlify these are set in Project configuration > Environment variables.

# Shop staff login (one shared account for the demo)
ADMIN_EMAIL=tienda@posventa.demo
ADMIN_PASSWORD=change-me

# Long random string used to sign the staff session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string

# "true" shows the demo credentials on the login page and enables the public
# "restore demo data" button. Turn off for a real shop.
DEMO_MODE=true
